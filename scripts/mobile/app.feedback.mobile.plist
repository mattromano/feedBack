<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/mobile/setup.sh replaces __RUN_SERVER__ and __LOG__ and installs
     the result as ~/Library/LaunchAgents/app.feedback.mobile.plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.feedback.mobile</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__RUN_SERVER__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
